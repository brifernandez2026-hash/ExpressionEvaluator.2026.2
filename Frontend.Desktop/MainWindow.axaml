<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Frontend.Desktop.MainWindow"
        Title="Functions Evaluator"
        Width="635"
        Height="455"
        CanResize="False"
        Background="#303840">

    <Window.Styles>
        <!-- Default button style -->
        <Style Selector="Button">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="Background" Value="#F4F4F4"/>
            <Setter Property="Foreground" Value="#303030"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>

        <!-- Orange operation buttons -->
        <Style Selector="Button.orange">
            <Setter Property="Background" Value="#F58C32"/>
            <Setter Property="Foreground" Value="#303030"/>
        </Style>
    </Window.Styles>

    <StackPanel Margin="14" Spacing="12">

        <!-- Green display -->
        <TextBox Name="Display"
                 Text="0"
                 IsReadOnly="True"
                 Height="74"
                 FontSize="29"
                 TextAlignment="Left"
                 VerticalContentAlignment="Center"
                 Background="#278A37"
                 Foreground="White"
                 BorderBrush="#D1E5D4"
                 BorderThickness="2"
                 Padding="12"/>

        <!-- Calculator keyboard -->
        <StackPanel Spacing="7">

            <!-- Row 1 -->
            <StackPanel Orientation="Horizontal"
                        Spacing="7"
                        HorizontalAlignment="Center">
                <Button Content="7" Click="OnButtonClick"/>
                <Button Content="8" Click="OnButtonClick"/>
                <Button Content="9" Click="OnButtonClick"/>
                <Button Classes="orange" Content="(" Click="OnButtonClick"/>
                <Button Classes="orange" Content=")" Click="OnButtonClick"/>
                <Button Classes="orange" Content="Delete"
                        Width="160" Click="OnButtonClick"/>
            </StackPanel>

            <!-- Row 2 -->
            <StackPanel Orientation="Horizontal"
                        Spacing="7"
                        HorizontalAlignment="Center">
                <Button Content="4" Click="OnButtonClick"/>
                <Button Content="5" Click="OnButtonClick"/>
                <Button Content="6" Click="OnButtonClick"/>
                <Button Classes="orange" Content="*" Click="OnButtonClick"/>
                <Button Classes="orange" Content="/" Click="OnButtonClick"/>
                <Button Classes="orange" Content="Clear"
                        Width="160" Click="OnButtonClick"/>
            </StackPanel>

            <!-- Row 3 -->
            <StackPanel Orientation="Horizontal"
                        Spacing="7"
                        HorizontalAlignment="Center">
                <Button Content="1" Click="OnButtonClick"/>
                <Button Content="2" Click="OnButtonClick"/>
                <Button Content="3" Click="OnButtonClick"/>
                <Button Classes="orange" Content="+" Click="OnButtonClick"/>
                <Button Classes="orange" Content="-" Click="OnButtonClick"/>
                <Button Classes="orange" Content="^"
                        Width="160" Click="OnButtonClick"/>
            </StackPanel>

            <!-- Row 4 -->
            <StackPanel Orientation="Horizontal"
                        Spacing="7"
                        HorizontalAlignment="Center">
                <Button Content="0" Width="159"
                        Click="OnButtonClick"/>
                <Button Content="." Click="OnButtonClick"/>
                <Button Classes="orange" Content="="
                        Width="325" Click="OnButtonClick"/>
            </StackPanel>

        </StackPanel>
    </StackPanel>
</Window>
